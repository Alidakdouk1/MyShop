{
  "name": "Pick&Go LB — Pick Smart. Go Further.",
  "short_name": "Pick&Go",
  "description": "Premium commerce in Lebanon. Curated products, fast delivery, easy returns.",
  "start_url": "/?utm_source=pwa",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0F172A",
  "theme_color": "#0F172A",
  "categories": ["shopping", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/brand/icon.svg",    "sizes": "any",     "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/brand/icon.svg",    "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/brand/icon.svg",    "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/brand/favicon.svg", "sizes": "64x64",   "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Shop",
      "short_name": "Shop",
      "description": "Browse all products",
      "url": "/shop?utm_source=pwa_shortcut",
      "icons": [{ "src": "/brand/icon.svg", "sizes": "any" }]
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "description": "View your recent orders",
      "url": "/account/orders?utm_source=pwa_shortcut",
      "icons": [{ "src": "/brand/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Cart",
      "short_name": "Cart",
      "description": "Go to your cart",
      "url": "/cart?utm_source=pwa_shortcut",
      "icons": [{ "src": "/brand/icon.svg", "sizes": "any" }]
    }
  ]
}
